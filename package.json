{
  "name": "@leon___/dsh-client-custom-skin",
  "version": "0.1.0",
  "description": "自定义皮肤：为 DSH Web 设置自定义背景图片，并调节对比度/亮度/模糊/可读性遮罩，让界面美观、可操作、可读。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/client.js",
    "src/index.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "REPLACE_WITH_YOUR_GITHUB_URL"
  }
}
